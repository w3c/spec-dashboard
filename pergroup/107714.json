  {
    "shortlink": "https://www.w3.org/TR/json-ld11-streaming/",
    "description": "<p>JSON-LD offers a JSON-based serialization for Linked Data. One of the primary uses of JSON-LD is its ability to exchange RDF data across the Web. This can be done by first serializing RDF to JSON-LD, after which data consumers can deserialize JSON-LD to RDF.</p>",
    "title": "Streaming JSON-LD",
    "shortname": "json-ld11-streaming",
    "editor-draft": "https://w3c.github.io/json-ld-streaming/",
